# =========================================================
# Lab 16 — LLM Provider Configuration
# Copy this file to .env and uncomment ONE provider block
# =========================================================

# ---------------------------------------------------------
# Option 1: NVIDIA NIM — Llama 3.3 70B (recommended opensource)
# Free tier: https://build.nvidia.com/meta/llama-3_3-70b-instruct
# ---------------------------------------------------------
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-...

# ---------------------------------------------------------
# Option 2: Groq — Llama 3.1 70B (free, very fast)
# Free tier: https://console.groq.com
# ---------------------------------------------------------
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...

# ---------------------------------------------------------
# Option 3: Ollama — fully local, no API key needed
# Install: https://ollama.com  then: ollama pull llama3.2
# ---------------------------------------------------------
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.2   # or: qwen2.5:7b, mistral, etc.

# ---------------------------------------------------------
# Option 4: OpenAI GPT-4o-mini (fallback)
# ---------------------------------------------------------
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
